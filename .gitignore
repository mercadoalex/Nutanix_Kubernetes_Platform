# NKP Demo — gitignore

# ── binaries & archives ───────────────────────────────────────────────────────
# nkp / dkp CLI binaries (large, redistributed from D2iQ/Nutanix CDN)
rootfs/bootstrap/nkp
downloads/*.tar.gz
downloads/*.tar
downloads/*.zip
downloads/*.exe

# Nutanix / OS images (large binary blobs — download separately)
downloads/*.iso
downloads/*.qcow2
downloads/*.img
downloads/rke2/

# ── build output ──────────────────────────────────────────────────────────────
# compiled rootfs ext4 images
dist/
*.ext4
*.ext4.zst

# Docker build cache artefacts
.buildx-cache*/

# build logs
build.log
*.build.log

# ── secrets & credentials ─────────────────────────────────────────────────────
*.b64
*.pem
*.key
*.crt
*.p12
kubeconfig
*.kubeconfig
nkp-env
.env
.env.*
*-env

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
__MACOSX/

# ── editors ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Python (build scripts) ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── Node (if any tooling is added) ───────────────────────────────────────────
node_modules/

# ── temporary files ───────────────────────────────────────────────────────────
/tmp/
*.tmp
*.log
*.bak

# ── RKE2 pre-downloaded binaries ─────────────────────────────────────────────
rootfs/rke2/*.tar.zst
rootfs/rke2/install.sh

# ── large course assets (committed separately / stored in LFS if needed) ──────
*.jpeg
*.jpg
*.png
!course-1/__static__/*.png
!course-1/**/__static__/*.png


# ── scratch / notes ───────────────────────────────────────────────────────────
nkp.txt
FEASIBILITY.md
scratch/
notes/

# ── GitHub Actions (disabled — using local macOS build instead) ─────────────
.github/

# ── bootstrap pre-downloaded binaries (populated by downloads/bootstrap/fetch.sh) ──
downloads/bootstrap/kubectl
downloads/bootstrap/kind
downloads/bootstrap/nkp_v*.tar.gz
downloads/bootstrap/helm-v*.tar.gz
downloads/bootstrap/flux_*.tar.gz
downloads/bootstrap/k9s_*.tar.gz
